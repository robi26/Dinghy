<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Syncthing's network access. On GrapheneOS this is a revocable
         per-app/per-profile toggle, so the app must degrade gracefully when it
         is denied rather than assume connectivity. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 17+. Required to reach peers directly on the local network
         instead of falling back to Syncthing's relays. Unknown permission names
         are ignored by older platforms, so this is safe to declare against
         compileSdk 36. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Local peer discovery is a UDP broadcast plus an IPv6 multicast, and
         Wi-Fi power save filters both out unless a multicast lock is held.
         Without this, devices on the same network are never found and
         addresses have to be entered by hand. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- A photo folder reads the library directly; nothing is ever copied, so
         this is the only way its files can be served. Read-only, and only
         asked for when such a folder is created. Partial ("selected photos")
         access is deliberately not supported: the folder would then hold only
         the chosen photos, and changing that selection would delete the rest
         from every device holding the backup.

         READ_MEDIA_VISUAL_USER_SELECTED is declared in order to *detect* that
         case, not to use it. Without the declaration Android 14+ runs the app
         in a compatibility mode where READ_MEDIA_IMAGES reads as granted while
         MediaStore quietly returns only the photos the user picked, which is
         exactly the situation that must not pass for a backup. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Without this, Android 10+ serves photos with their GPS tags removed,
         so the backup would lose where every photo was taken. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- A foreground service must post a notification to run reliably. Users
         who do not want it can disable the channel and still grant this. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Needed only to *ask* for the battery-optimization exemption. Without the
         exemption the system will eventually stop the node. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".DinghyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dinghy">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- `dataSync` would be the obvious type, but since Android 15 it is
                 capped at six hours per day, which a sync daemon exceeds. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuously synchronizes files with the user's own devices over Syncthing, which requires a long-lived network connection." />
        </service>

        <!-- Puts synced folders in the system file picker. Files that were
             never downloaded are served through a proxy file descriptor backed
             by the engine's streaming server. -->
        <provider
            android:name=".provider.DinghyDocumentsProvider"
            android:authorities="ch.steigis.dinghy.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <service
            android:name=".service.SyncTileService"
            android:exported="true"
            android:icon="@drawable/ic_dinghy_mono"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true"
            tools:ignore="UnusedAttribute">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
