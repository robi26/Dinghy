<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Adaptive icon background. The full 108dp square is painted: launcher masks
      crop it to anything from a circle to a squircle, so the gradient has to
      reach every corner.
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF4F46E5" />
                <item android:offset="0.55" android:color="#FF0EA5E9" />
                <item android:offset="1" android:color="#FF22D3EE" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
