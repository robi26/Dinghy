<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      A dinghy drawn in Overprint's line style: teal and blue outlines with
      faint seams standing in for its map grid, white for the hull, and a wake
      that runs from a start dot to the teal dot at the masthead the way
      Overprint's track does. A small sync mark takes the corner spot where
      Overprint keeps its crosshair.

      The jib overlaps the mainsail and is filled and stroked in the
      background colour, so it cuts the mainsail's lines with a thin gap rather
      than crossing them.

      Only the centre 72dp of the 108dp layer is guaranteed visible, so the
      boat is drawn large and scaled down about the centre, nudged up a little
      to balance the wake. Every point stays within ~34dp of centre, inside the
      36dp radius a circular mask leaves.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8"
        android:translateY="-1.6">

        <!-- mainsail seams, clipped to the sail -->
        <group>
            <clip-path android:pathData="M56,24 C65,32 73,46 78,62 L56,62 Z" />
            <path
                android:pathData="M50,34 Q67,31 84,32 M50,43 Q67,40 84,41 M50,52 Q67,49 84,50"
                android:strokeColor="#FF34D9B5"
                android:strokeAlpha="0.35"
                android:strokeWidth="1" />
        </group>

        <!-- mainsail -->
        <path
            android:pathData="M56,24 C65,32 73,46 78,62 L56,62 Z"
            android:strokeColor="#FF34D9B5"
            android:strokeWidth="3"
            android:strokeLineJoin="round" />

        <!-- jib knockout: hides the mainsail where the jib overlaps it -->
        <path
            android:pathData="M50,32 C53,41 57,51 60,62 L31,62 Z"
            android:fillColor="#FF0B1B33"
            android:strokeColor="#FF0B1B33"
            android:strokeWidth="5"
            android:strokeLineJoin="round" />

        <!-- jib seams, clipped to the sail -->
        <group>
            <clip-path android:pathData="M50,32 C53,41 57,51 60,62 L31,62 Z" />
            <path
                android:pathData="M26,42 Q45,39 64,40 M26,52 Q45,49 64,50"
                android:strokeColor="#FF1D6BF0"
                android:strokeAlpha="0.5"
                android:strokeWidth="1" />
        </group>

        <!-- jib -->
        <path
            android:pathData="M50,32 C53,41 57,51 60,62 L31,62 Z"
            android:strokeColor="#FF1D6BF0"
            android:strokeWidth="3"
            android:strokeLineJoin="round" />

        <!-- hull -->
        <path
            android:pathData="M27,67 L81,67 C78.5,77 68,82 54,82 C40,82 29.5,77 27,67 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="3.2"
            android:strokeLineJoin="round" />

        <!-- masthead: the end of the track -->
        <path
            android:pathData="M52.4,24 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0 Z"
            android:fillColor="#FF34D9B5" />

        <!-- wake, ending in the start dot -->
        <path
            android:pathData="M58,86.5 C46,86.5 46,93 34,93"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2.6"
            android:strokeLineCap="round" />
        <path
            android:pathData="M31.4,93 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z"
            android:fillColor="#FFFFFFFF" />
    </group>

    <!-- sync mark -->
    <group
        android:translateX="73"
        android:translateY="35"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <path
            android:pathData="M-5.5,-1 A5.6,5.6 0 0,1 4.3,-3.6 M4.6,-6.4 L4.3,-3.6 L1.5,-3.9 M5.5,1 A5.6,5.6 0 0,1 -4.3,3.6 M-4.6,6.4 L-4.3,3.6 L-1.5,3.9"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
