<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Themed-icon layer for Android 13+. The system ignores these colours and
      tints the layer by the wallpaper, so the mark has to survive as a
      silhouette: the gap between the sails is what keeps it from collapsing
      into one blob, and the water is held at a lower alpha so it reads as
      secondary rather than as part of the hull. Geometry is kept identical to
      ic_launcher_foreground so the two never drift apart.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.18"
        android:scaleY="1.18">

        <path
            android:pathData="M52,36 C47,41 41,47 36,52 L52,52 Z"
            android:fillColor="#FF000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="2.8"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M56,30 C64,36 70,45 74,52 L56,52 Z"
            android:fillColor="#FF000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="2.8"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M32,54 L76,54 C74.5,63 66,68.5 54,68.5 C42,68.5 33.5,63 32,54 Z"
            android:fillColor="#FF000000"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.8"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M37,75 c4.5,-3 9,-3 13.5,0 c4.5,3 9,3 13.5,0 c3,-2 6,-2.4 9,-1"
            android:strokeColor="#FF000000"
            android:strokeAlpha="0.5"
            android:strokeWidth="3.2"
            android:strokeLineCap="round" />
    </group>
</vector>
