# Toolchains (project-local, not committed). No trailing slash: the
# directory is sometimes a symlink to a toolchain shared with another
# checkout, and `/toolchains/` matches only a real directory.
/toolchains

# Gradle / Android
.gradle/
build/
local.properties
*.apk
*.aab
/app/libs/*.aar

# Go
/core/build/

# Release signing (never commit)
keystore.properties
*.jks
*.keystore

# Staged release artifacts
/dist/
